{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "pins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pref', 'at'])",
        "pref": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 5" },
        "at": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "votes": {
      "$week": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 10"
        }
      }
    },

    "footprints": {
      "$week": {
        ".read": "auth != null",
        "$date": {
          ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === now"
          }
        }
      }
    },

    "wishLog": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() > 60000)"
      }
    },

    "wishes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('wishLog').child(auth.uid).val() === now) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['uid', 'text', 'name', 'week', 'at'])",
        "uid": { ".validate": "newData.isString()" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "week": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "root.child('admins').child(auth.uid).val() === true && (newData.val() === 'published' || newData.val() === 'hidden')" },
        "$other": { ".validate": false }
      }
    },

    "publicWishes": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['text', 'name', 'at'])"
      }
    }
  }
}
